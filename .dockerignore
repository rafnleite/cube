# Ignoring builds for native from local machime to protect a problem with different architecture
packages/cubejs-backend-native/index.node
packages/cubejs-backend-native/native/
# Caches
packages/cubejs-backend-native/target
packages/*/node_modules/
packages/*/dist/
packages/*/coverage/
# Other
packages/cubejs-server-core/playground/

# The portable development image starts without a bind mount, so it needs the
# already compiled JavaScript and Playground bundle. Native Linux artifacts
# remain excluded above and are inherited from the Linux base image.
!packages/*/dist/
!packages/*/dist/**
!packages/cubejs-server-core/playground/
!packages/cubejs-server-core/playground/**
